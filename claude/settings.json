{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "skillListingBudgetFraction": 0.04,
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "30",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "4"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(fd:*)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(bats:*)",
      "Bash(shellcheck:*)",
      "Bash(kit *)",
      "Bash(/Users/ku5ic/.claude/plugins/marketplaces/ku5ic/bin/kit *)",
      "Bash(bin/kit *)",
      "Bash(rg *)",
      "Bash(git log *)",
      "Bash(tokei:*)",
      "Bash(claude plugin list *)",
      "Bash(defaults read:*)",
      "Bash(pnpm exec jest:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu fmt -check:*)",
      "Bash(aws configure list-profiles)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws logs describe-log-groups:*)",
      "Bash(aws ssm describe-parameters:*)",
      "Bash(aws iam get-role:*)",
      "Bash(aws s3api list-buckets:*)",
      "Bash(aws s3api list-object-versions:*)",
      "Edit(**)",
      "Read(**)",
      "WebSearch",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitejs.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:w3.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.djangoproject.com)",
      "WebFetch(domain:docs.ruby-lang.org)",
      "WebFetch(domain:ruby-doc.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:guides.rubyonrails.org)",
      "WebFetch(domain:api.rubyonrails.org)",
      "WebFetch(domain:edgeguides.rubyonrails.org)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:pydantic.dev)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:storybook.js.org)",
      "WebFetch(domain:floating-ui.com)",
      "WebFetch(domain:testing-library.com)",
      "WebFetch(domain:changesets.guide)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf ../*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(env)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(launchctl *)",
      "Bash(defaults *)",
      "Bash(nvram *)",
      "Bash(scutil *)",
      "Bash(pfctl *)",
      "Bash(softwareupdate *)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(**/credentials.ts)",
      "Edit(**/credentials.ts)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Edit(~/.aws/config)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.pgpass)",
      "Edit(~/.pgpass)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/Keychains/**)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.cargo/credentials)",
      "Edit(~/.cargo/credentials)",
      "Read(~/.gem/credentials)",
      "Edit(~/.gem/credentials)"
    ],
    "ask": [
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew reinstall:*)",
      "Bash(brew rm:*)",
      "Bash(brew remove:*)",
      "Bash(brew cleanup:*)",
      "Bash(brew autoremove:*)",
      "Bash(brew bundle:*)",
      "Bash(cargo install:*)",
      "Bash(cargo uninstall:*)",
      "Bash(cargo publish:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh ssh-key:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git clean:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(git -C * branch -D *)",
      "Bash(git -C * branch -d *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * commit --amend *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * reflog expire *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * tag -d *)",
      "Bash(mogrify *)",
      "Bash(npm audit fix:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm link:*)",
      "Bash(npm publish:*)",
      "Bash(npm rm:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(open *)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm link:*)",
      "Bash(psql *)",
      "Bash(redis-cli *)",
      "Bash(rustup update:*)",
      "Bash(rustup install:*)",
      "Bash(wget *)",
      "Bash(bun add:*)",
      "Bash(bun install:*)",
      "Bash(bun remove:*)",
      "Bash(bun update:*)",
      "Bash(bun publish:*)",
      "Bash(bun link:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(yarn remove:*)",
      "Bash(yarn upgrade:*)",
      "Bash(yarn publish:*)",
      "Bash(yarn link:*)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/next.config.*)",
      "Edit(**/vite.config.*)",
      "Edit(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Edit(**/biome.json)",
      "Edit(**/prettier.config.*)",
      "Edit(**/.prettierrc*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": ["~/.claude", "~/.dotfiles"]
  },
  "model": "opus",
  "skillOverrides": {
    "auto-mode-setup": "off",
    "fastapi-patterns": "off",
    "bash-patterns": "name-only",
    "django-patterns": "name-only",
    "docker-patterns": "name-only",
    "engineering-fundamentals": "name-only",
    "go-patterns": "name-only",
    "graphql-patterns": "name-only",
    "javascript-patterns": "name-only",
    "next-app-router-patterns": "name-only",
    "nuxt-patterns": "name-only",
    "opentofu-patterns": "name-only",
    "python-patterns": "name-only",
    "react-patterns": "name-only",
    "storybook-patterns": "name-only",
    "tailwind-patterns": "name-only",
    "test-patterns": "name-only",
    "typescript-patterns": "name-only",
    "vue-patterns": "name-only"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/plugins/marketplaces/ku5ic/bin/kit statusline",
    "padding": 0,
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "kit@ku5ic": true
  },
  "extraKnownMarketplaces": {
    "spacelift-engineering": {
      "source": {
        "source": "github",
        "repo": "spacelift-io/engineering-agent-skills"
      }
    },
    "ku5ic": {
      "source": {
        "source": "github",
        "repo": "ku5ic/claude-kit"
      },
      "autoUpdate": true
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "fable": {
      "effortLevel": "high"
    },
    "opus": {
      "effortLevel": "high"
    },
    "sonnet": {
      "effortLevel": "high"
    },
    "haiku": {
      "effortLevel": "medium"
    }
  },
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "kit@ku5ic": {
      "options": {
        "preset": "default",
        "reply_length": "terse"
      }
    }
  },
  "plansDirectory": ".claude/plans",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "autoMemoryEnabled": true,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": ["$defaults"],
    "soft_deny": [
      "$defaults",
      "Never run database migrations outside the project's migration CLI, even against a dev database"
    ],
    "hard_deny": ["$defaults"]
  },
  "voiceEnabled": true
}

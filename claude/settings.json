      "Skill(audit-debt)",
      "Skill(audit-doc-drift)",
      "Skill(audit-perf)",
      "Skill(audit-security)",
      "Skill(flow-checks)",
      "Skill(flow-fix)",
      "Skill(flow-quick)",
      "Skill(flow-implement)",
      "Skill(flow-plan)",
      "Skill(flow-preflight)",
      "Skill(flow-resume)",
      "Skill(flow-review)",
      "Skill(flow-test)",
      "Skill(meta-feature)",
      "Skill(meta-prompt)",
      "Skill(meta-retro)",
      "Skill(write-commit)",
      "Skill(write-pr)",
      "Skill(write-release-notes)",
      "Skill(write-stakeholder)",
      "Skill(bash-patterns)",
      "Skill(django-patterns)",
      "Skill(engineering-fundamentals)",
      "Skill(javascript-patterns)",
      "Skill(markdown-report)",
      "Skill(next-app-router-patterns)",
      "Skill(nuxt-patterns)",
      "Skill(python-patterns)",
      "Skill(react-patterns)",
      "Skill(security-patterns)",
      "Skill(tailwind-patterns)",
      "Skill(test-patterns)",
      "Skill(typescript-patterns)",
      "Skill(vue-patterns)",
      "Skill(wcag-audit)",
      "Skill(docker-patterns)",
      "Skill(fastapi-patterns)",
      "Skill(drf-patterns)",
      "Skill(backup-patterns)",
      "Skill(vps-provisioning)",
      "Skill(logging-patterns)",
      "Skill(git-patterns)",
      "Skill(monitoring-patterns)",
      "Skill(skill-authoring)",
      "Agent(scout)",
      "Agent(reviewer)",
      "Agent(tester)",
      "Agent(checker)",
      "Agent(debugger)",
      "Agent(a11y-auditor)",
      "Agent(security-auditor)",
      "Agent(perf-auditor)",
      "Agent(debt-auditor)",
      "Agent(claude-config-auditor)",
      "Agent(doc-drift-auditor)",
      "Edit(**)",
      "Read(**)",
      "Edit(~/.claude/scratch/**)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:typescriptlang.org)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:vitejs.dev)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:w3.org)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:pypi.org)",
      "WebFetch(domain:docs.djangoproject.com)",
      "WebFetch(domain:docs.ruby-lang.org)",
      "WebFetch(domain:ruby-doc.org)",
      "WebFetch(domain:rubygems.org)",
      "WebFetch(domain:guides.rubyonrails.org)",
      "WebFetch(domain:api.rubyonrails.org)",
      "WebFetch(domain:edgeguides.rubyonrails.org)",
      "WebFetch(domain:fastapi.tiangolo.com)",
      "WebFetch(domain:pydantic.dev)",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:storybook.js.org)",
      "WebFetch(domain:floating-ui.com)",
      "WebFetch(domain:testing-library.com)",
      "WebFetch(domain:changesets.guide)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf ../*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(env)",
      "Bash(mkfs *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(launchctl *)",
      "Bash(defaults *)",
      "Bash(nvram *)",
      "Bash(scutil *)",
      "Bash(pfctl *)",
      "Bash(softwareupdate *)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/id_rsa)",
      "Edit(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Edit(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Edit(**/id_ecdsa)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Edit(~/.aws/credentials)",
      "Read(~/.aws/config)",
      "Edit(~/.aws/config)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.pgpass)",
      "Edit(~/.pgpass)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/Keychains/**)",
      "Read(~/.pypirc)",
      "Edit(~/.pypirc)",
      "Read(~/.cargo/credentials)",
      "Edit(~/.cargo/credentials)",
      "Read(~/.gem/credentials)",
      "Edit(~/.gem/credentials)"
    ],
    "ask": [
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(brew upgrade:*)",
      "Bash(brew reinstall:*)",
      "Bash(brew rm:*)",
      "Bash(brew remove:*)",
      "Bash(brew cleanup:*)",
      "Bash(brew autoremove:*)",
      "Bash(brew bundle:*)",
      "Bash(cargo install:*)",
      "Bash(cargo uninstall:*)",
      "Bash(cargo publish:*)",
      "Bash(curl *)",
      "Bash(gh auth:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh ssh-key:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git clean:*)",
      "Bash(git commit --amend:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(git -C * branch -D *)",
      "Bash(git -C * branch -d *)",
      "Bash(git -C * clean *)",
      "Bash(git -C * commit --amend *)",
      "Bash(git -C * push *)",
      "Bash(git -C * rebase *)",
      "Bash(git -C * reflog expire *)",
      "Bash(git -C * reset *)",
      "Bash(git -C * tag -d *)",
      "Bash(mogrify *)",
      "Bash(npm audit fix:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm link:*)",
      "Bash(npm publish:*)",
      "Bash(npm rm:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npm ci:*)",
      "Bash(open *)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm update:*)",
      "Bash(pnpm publish:*)",
      "Bash(pnpm link:*)",
      "Bash(psql *)",
      "Bash(redis-cli *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(rustup update:*)",
      "Bash(rustup install:*)",
      "Bash(wget *)",
      "Bash(bun add:*)",
      "Bash(bun install:*)",
      "Bash(bun remove:*)",
      "Bash(bun update:*)",
      "Bash(bun publish:*)",
      "Bash(bun link:*)",
      "Bash(yarn add:*)",
      "Bash(yarn install:*)",
      "Bash(yarn remove:*)",
      "Bash(yarn upgrade:*)",
      "Bash(yarn publish:*)",
      "Bash(yarn link:*)",
      "Edit(**/tsconfig*.json)",
      "Edit(**/next.config.*)",
      "Edit(**/vite.config.*)",
      "Edit(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Edit(**/biome.json)",
      "Edit(**/prettier.config.*)",
      "Edit(**/.prettierrc*)"
    ],
    "defaultMode": "default",
    "additionalDirectories": ["~/.claude", "~/.dotfiles"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-commit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-edit.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-skills.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-tone.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-skills.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sanitize-output.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-shell.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/lint-shell.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-lua.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-prettier.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "42crunch-api-security-testing@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "frontend-spacelift@spacelift-engineering": true
  },
  "extraKnownMarketplaces": {
    "spacelift-engineering": {
      "source": {
        "source": "github",
        "repo": "spacelift-io/engineering-agent-skills"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "theme": "auto",
  "agentPushNotifEnabled": true
}

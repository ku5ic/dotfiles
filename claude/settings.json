    "defaultMode": "auto",
    "additionalDirectories": ["~/.claude", "~/.dotfiles"]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-bash.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-commit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard-dispatch.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/sanitize-output.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/format-dispatch.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject-context.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/log-skills.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-mode-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-checks.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject-subagent-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/bin/statusline.sh",
    "padding": 0,
    "refreshInterval": 1
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/bin/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": false,
    "frontend-spacelift@spacelift-engineering": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "spacelift-engineering": {
      "source": {
        "source": "github",
        "repo": "spacelift-io/engineering-agent-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "Proactive",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {},
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": true,
  "theme": "auto",
  "editorMode": "vim",
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": ["$defaults"],
    "soft_deny": [
      "$defaults",
      "Never run database migrations outside the project's migration CLI, even against a dev database"
    ],
    "hard_deny": ["$defaults"]
  }
}
